{
  "name": "@caleb/loopmessage-sdk",
  "version": "1.0.0",
  "description": "Fully-typed TypeScript SDK for the Loop Message iMessage API",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "biome check src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
