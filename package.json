{
  "name": "@loopmessagesdk/loopmessage-sdk",
  "version": "1.2.0",
  "description": "Unofficial TypeScript SDK for the Loop Message cloud API. Send real iMessages (blue bubbles) from your backend. Covers send, campaigns, webhooks, opt-ins, reactions, and voice. Zero dependencies. Bun + Node.js.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "imessage",
    "loopmessage",
    "iMessage API",
    "sms",
    "messaging",
    "typescript",
    "bun",
    "webhook",
    "apple"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
